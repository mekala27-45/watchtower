PORT=4318
HOST=127.0.0.1
WATCHTOWER_DB=state/local.sqlite
WATCHTOWER_ORIGINS=http://127.0.0.1:4318
BUILD_REVISION=local-candidate
WATCHTOWER_DEPLOYMENT=local
WATCHTOWER_MIGRATE=0
# Local SQLite is the default. The application does not load this file automatically.
# For Postgres, supply DATABASE_URL only in an approved process or platform secret setting.
# Use the direct Neon hostname; pooled hostnames are refused and TLS certificates are verified.
# Production requires DATABASE_URL and WATCHTOWER_DEPLOYMENT=production.
# Set WATCHTOWER_MIGRATE=1 only for an intended operator migration, then restore it to 0.
# Set WATCHTOWER_ORIGINS to the actual Pages HTTPS origin for the public API.
# WATCHTOWER_PUBLIC_API_ORIGIN is a public HTTPS origin used only by the static build.
# Never put DATABASE_URL, a capability, or any credential into public client configuration.
